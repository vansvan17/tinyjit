// Precedence, associativity, signed division and 63-bit wraparound.
fn main() {
  print(1 + 2 * 3);          // expect: 7
  print((1 + 2) * 3);        // expect: 9
  print(10 - 3 - 2);         // expect: 5
  print(-7 / 2);             // expect: -3
  print(-7 % 2);             // expect: -1
  print(7 % -2);             // expect: 1
  print(100 / 7 * 7);        // expect: 98
  print(-(-5));              // expect: 5
  print(!0);                 // expect: 1
  print(!5);                 // expect: 0
  print(!nil);               // expect: 0
  print(3 < 4);              // expect: 1
  print(4 <= 3);             // expect: 0
  print(4 >= 4);             // expect: 1
  print(5 > 6);              // expect: 0
  print(2 == 2);             // expect: 1
  print(2 != 2);             // expect: 0
  print(nil == nil);         // expect: 1
  let max = 4611686018427387903;
  print(max);                // expect: 4611686018427387903
  print(max + 1);            // expect: -4611686018427387904
  print(max * 2);            // expect: -2
  let big = 3000000000;
  print(big * 3);            // expect: 9000000000
  print(big + big);          // expect: 6000000000
  print(true + true);        // expect: 2
}
