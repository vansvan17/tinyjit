fn range(n) { let l = nil; while n > 0 { n = n - 1; l = cons(n, l); } return l; }
fn length(l) { let n = 0; while is_pair(l) { n = n + 1; l = cdr(l); } return n; }
fn sum(l) { let s = 0; while !is_nil(l) { s = s + car(l); l = cdr(l); } return s; }
fn reverse(l) { let r = nil; while is_pair(l) { r = cons(car(l), r); l = cdr(l); } return r; }
fn squares(l) { if is_nil(l) { return nil; } return cons(car(l) * car(l), squares(cdr(l))); }
fn main() {
  let l = range(5);
  print(l);                       // expect: (0 1 2 3 4)
  print(reverse(l));              // expect: (4 3 2 1 0)
  print(squares(l));              // expect: (0 1 4 9 16)
  print(length(range(1000)));     // expect: 1000
  print(sum(range(1000)));        // expect: 499500
  print(cons(1, 2));              // expect: (1 . 2)
  print(cons(cons(1, nil), cons(2, 3))); // expect: ((1) 2 . 3)
  print(nil);                     // expect: nil
  print(is_pair(nil));            // expect: 0
  print(is_pair(l));              // expect: 1
  print(is_nil(nil));             // expect: 1
  print(car(cdr(cdr(l))));        // expect: 2
  // sum/length take lists but do not allocate, so the JIT may compile them
  let i = 0; let t = 0;
  while i < 300 { t = t + sum(l) + length(l); i = i + 1; }
  print(t);                       // expect: 4500
}
