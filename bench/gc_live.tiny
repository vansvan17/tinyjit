fn range(n) { let l = nil; while n > 0 { n = n - 1; l = cons(n, l); } return l; }
fn main() {
  let live = nil;
  let i = 0;
  let acc = 0;
  while i < 400 {
    live = cons(range(500), live);
    let j = 0;
    while j < 20 {
      let junk = range(100);
      acc = acc + car(cdr(junk));
      j = j + 1;
    }
    i = i + 1;
  }
  let n = 0;
  while is_pair(live) { n = n + car(cdr(car(live))); live = cdr(live); }
  print(acc);
  print(n);
}
